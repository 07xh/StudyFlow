{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "学序 StudyFlow",
  "version": "0.1.1-rc.39",
  "identifier": "app.studyflow.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "统一学习助手 · 学序",
        "width": 1150,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../packaging/sidecar/studyflow-bridge.exe": "bin/studyflow-bridge.exe",
      "../legacy/zhidao/Official-Player.ps1": "legacy/zhidao/Official-Player.ps1",
      "../legacy/zhidao/Official-MediaController.js": "legacy/zhidao/Official-MediaController.js",
      "../legacy/zhidao/Install-WebView2.ps1": "legacy/zhidao/Install-WebView2.ps1",
      "../legacy/zhidao/使用条款与第三方声明.txt": "legal/使用条款与第三方声明.txt",
      "../legacy/zhidao/隐私政策与数据说明.txt": "legal/隐私政策与数据说明.txt",
      "../legacy/zhidao/StudyFlow-隐私补充说明.txt": "legal/StudyFlow-隐私补充说明.txt",
      "../legacy/zhidao/LICENSE-GPL-3.0.txt": "legal/LICENSE-GPL-3.0.txt",
      "../legacy/zhidao/SOURCE.md": "legal/SOURCE.md"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerHooks": "./windows/install-hooks.nsh"
      }
    }
  }
}
